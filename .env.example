# Copy to .env for local development. Never commit the filled-in copy.
# In production every value below is resolved from GCP Secret Manager instead.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- GCP ---
# Locally, authenticate with: gcloud auth application-default login
GCP_PROJECT_ID=
GCP_REGION=europe-west2

# --- Vertex AI ---
VERTEX_CHAT_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-embedding-005
VERTEX_EMBED_DIMENSIONS=768

# --- Knowledge index ---
# Index artifact is loaded from GCS at container start, with the copy baked
# into the image as fallback. Leave the bucket empty to force the local file.
KNOWLEDGE_BUCKET=
KNOWLEDGE_INDEX_OBJECT=index/latest.json

# --- Firestore ---
FIRESTORE_DATABASE=(default)
BUDGET_CACHE_TTL_SECONDS=900

# --- Google Sheets budget tracker ---
BUDGET_SPREADSHEET_ID=
BUDGET_SHEET_RANGE=

# --- Transactional email ---
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM_ADDRESS=

# --- Security ---
# Comma separated. Empty allows all origins, which is only acceptable locally.
ALLOWED_ORIGINS=
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
