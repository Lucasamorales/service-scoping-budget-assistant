# Copy to .env for local development. Never commit the filled-in copy.
# In production secrets are resolved from GCP Secret Manager instead.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Gemini Developer API (chat + embeddings) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768

# --- GCP project (Firestore / Sheets — not used for Gemini) ---
GCP_PROJECT_ID=your-gcp-project
# From scripts/provision_sheets_sa.ps1 — never commit the JSON key.
GOOGLE_APPLICATION_CREDENTIALS=secrets/your-gcp-project-sheets.json
# Plan which lookups a turn needs (scope / budget / list / …). Off = pattern router only.
USE_LLM_PLANNER=true
# Word the answer from the facts the tools returned. Off = deterministic sentences.
USE_LLM_COMPOSER=true
# Off unless you explicitly want embedding-based “list services” paraphrase routing.
USE_SEMANTIC_INVENTORY=false

# --- Firestore ---
FIRESTORE_DATABASE=(default)

# --- Budget / quote (Google Sheet = source of truth when ID is set) ---
# How long budget figures are cached before the sheet is re-read.
BUDGET_CACHE_TTL_SECONDS=900
# Offline/dev only — ignored for budget/roster/prices once BUDGET_SPREADSHEET_ID is set.
BUDGET_XLSX_PATH=fixtures/budget/acme_scope_db.xlsx
# Spreadsheet id from https://docs.google.com/spreadsheets/d/<ID>/edit
BUDGET_SPREADSHEET_ID=
# Offline fallback only. With BUDGET_SPREADSHEET_ID set, both halves come from
# the sheet: Pricing_tiers for tier→price and Scope for service→tier.
# Refresh this file with scripts/refresh_rate_card.py; do not hand-edit it.
QUOTE_RATE_CARD_PATH=fixtures/quote/rate_card.json
# Spreadsheet is Viewer/read-only. No Form writes.

# --- Contacts / audit ---
CONTACTS_PATH=fixtures/contacts/country_ams.json
AUDIT_LOG_PATH=artifacts/audit
# auto = Firestore when GCP_PROJECT_ID is set (dual-write with JSONL); jsonl = local only.
AUDIT_BACKEND=auto

# --- Transactional email (Resend) ---
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM_ADDRESS=

# --- Security ---
# Comma-separated scheme://host list of every site allowed to embed the widget,
# e.g. https://www.example.org. Empty means same-origin only, which is right
# until the widget is embedded somewhere this service does not serve itself.
ALLOWED_ORIGINS=
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL_SECONDS=3600
# How long a "shall I email your AM?" CTA stays confirmable.
PENDING_ACTION_TTL_SECONDS=900
INTERNAL_ACCESS_PASSWORD=
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
