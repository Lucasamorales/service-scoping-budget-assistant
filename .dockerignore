.git
.gcloudignore

.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov

.env
.env.*
secrets
*-service-account.json
credentials.json

# The knowledge index is built by scripts/deploy_cloud_run.ps1 before the
# upload, because embedding needs a Gemini key and Cloud Build has none.
# Everything else under artifacts/ is local audit output and stays out.
artifacts/*
!artifacts/index.json
graphify-out

widget/node_modules

.idea
.vscode
.DS_Store
Thumbs.db

docs
evals
tests

# Meeting transcript, not catalog. Filename is not ASCII; Cloud Run
# refuses to import an image that contains it.
documents/Meeting started*

# Design source for the request emails and the PDF. The drop-in templates and
# assets from it are committed under app/assets and widget/assets; the mockups,
# previews and uploads are reference material and stay out of the image.
email and pdf from claude design
